# Copy to .env and fill in. Never commit .env.
APP_NAME=DevInvestigator
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- GitHub ---
GITHUB_API_URL=https://api.github.com
# Shared secret configured on the GitHub webhook. Required: deliveries are rejected without it.
GITHUB_WEBHOOK_SECRET=

# Auth option A: fine-grained token, read-only (Actions: read, Contents: read, Metadata: read)
GITHUB_TOKEN=

# Auth option B: GitHub App (takes precedence over GITHUB_TOKEN when GITHUB_APP_ID is set)
GITHUB_APP_ID=
# Either a path to the PEM file (preferred) or the PEM contents with \n escapes
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=

# Evidence limits
GITHUB_LOG_MAX_BYTES=200000
GITHUB_MAX_FAILED_JOB_LOGS=5

# --- AI provider ---
# ollama   = local model, needs a GPU, evidence never leaves your server
# anthropic / openai = API model, no GPU needed, evidence is sent to that provider
# vllm     = your own OpenAI-compatible server (set OPENAI_BASE_URL)
LLM_PROVIDER=ollama
# Optional: overrides the chosen provider's model below
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=16000
LLM_MAX_RETRIES=2

# --- Local AI (LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=hf.co/ggml-org/gemma-4-31b-it-GGUF:Q4_K_M
# Ollama already on the host: http://host.docker.internal:11434
# Bundled container (docker compose --profile local-ai): http://ollama:11434
# Outside Docker: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=16384
# Models tagged ":cloud" run on Ollama's servers, not yours, so they are refused by default
OLLAMA_ALLOW_CLOUD_MODELS=false
# GPU for the bundled container (index or UUID)
DEVINVESTIGATOR_GPU=0

# --- API AI, no GPU needed (LLM_PROVIDER=anthropic / openai / vllm) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# For vLLM or another OpenAI-compatible server, e.g. http://vllm:8000/v1
OPENAI_BASE_URL=

# --- Agent investigation (Phase 7, triggered manually via `python -m app.cli investigate`) ---
AGENT_MAX_TOOL_CALLS=6
AGENT_TOOL_BUDGET_CHARS=24000

# --- Investigations (automatic after every failed run) ---
# SQLite file on the Docker volume by default. For PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/devinvestigator
DATABASE_URL=sqlite+aiosqlite:///./data/devinvestigator.db
# false = collect and store evidence only, no LLM analysis
AUTO_ANALYZE=true
# agent (may read files, compare commits) or single_pass (one LLM call on the logs)
ANALYSIS_MODE=agent
INVESTIGATION_TIMEOUT_SECONDS=900

# --- Web page: https://YOUR-HOST/investigations (HTTP Basic auth) ---
# The page stays disabled until a password is set. Use a long random one: openssl rand -base64 24
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Interactive API docs at /docs (off by default: the service is internet-facing)
ENABLE_API_DOCS=false

# --- Notifications: post the result as a GitHub comment (the only write this tool can do) ---
# Off by default. Uses its own token so the investigation token stays read-only.
NOTIFY_GITHUB_COMMENTS=false
# Fine-grained token with "Pull requests: write" (comment on the PR) and, for pushes straight to a
# branch, "Contents: write" (comment on the commit). Nothing else is ever called.
GITHUB_COMMENT_TOKEN=
# Public address of this server, used for the "Full investigation" link in comments
PUBLIC_BASE_URL=
